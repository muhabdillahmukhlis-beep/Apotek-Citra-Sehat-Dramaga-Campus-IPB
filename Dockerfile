FROM php:8.2-apache`n`n# 1. Install system dependencies & PHP extensions`nRUN apt-get update && apt-get install -y libpng-dev libjpeg-dev libfreetype6-dev libzip-dev libonig-dev libxml2-dev zip unzip git curl && docker-php-ext-configure gd --with-freetype --with-jpeg && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip`n`n# 2. Enable Apache rewrite module untuk Laravel routing`nRUN a2enmod rewrite`n`n# 3. Ubah Document Root Apache ke folder public Laravel`nENV APACHE_DOCUMENT_ROOT /var/www/html/public`nRUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf`nRUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf`n`n# 4. Setup working directory`nWORKDIR /var/www/html`nCOPY . .`n`n# 5. Install Composer & dependencies`nRUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer`nRUN composer install --no-dev --optimize-autoloader`n`n# 6. Set proper permissions`nRUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache`n`nEXPOSE 80
